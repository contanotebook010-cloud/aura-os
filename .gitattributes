# Scripts de shell precisam de terminações LF: CRLF quebra o bash no Linux.
*.sh text eol=lf
iso/airootfs/**/*.sh text eol=lf
iso/airootfs/usr/local/bin/aura-first-boot text eol=lf
iso/airootfs/usr/local/bin/aura-session-ready text eol=lf
iso/airootfs/etc/systemd/system/*.service text eol=lf
iso/airootfs/etc/systemd/system/*.timer text eol=lf
*.yml text eol=lf
PKGBUILD text eol=lf
