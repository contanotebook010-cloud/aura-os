alacritty
thunar
thunar-archive-plugin
file-roller
mpv
eog
firefox
libreoffice-fresh
libreoffice-fresh-pt-br
yt-dlp
ffmpeg

# --- Sistema ---
sudo
git
base-devel
xdg-user-dirs
polkit-gnome
htop
fastfetch

# --- Boot (BIOS legado e UEFI) ---
syslinux
systemd

