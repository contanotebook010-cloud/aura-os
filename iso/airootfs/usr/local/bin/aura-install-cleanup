#!/usr/bin/env bash
# Remove artefatos exclusivos da live do sistema instalado pelo Calamares.
# Executado dentro do chroot do sistema de destino.
set -euo pipefail

readonly LIVE_USER="aura"

# O sudo sem senha existe somente na live. A instalação cria uma regra normal
# para o grupo wheel, que exige a senha do usuário instalado.
rm -f -- /etc/sudoers.d/10-aura-live
if grep -Rqs --include='*aura*' 'NOPASSWD' /etc/sudoers.d; then
  echo "erro: ainda existe uma regra NOPASSWD da live" >&2
  exit 1
fi

# Remove o autologin e mantém apenas a sessão XFCE no LightDM.
install -d -m 0755 /etc/lightdm
cat > /etc/lightdm/lightdm.conf <<'EOF'
[LightDM]
logind-check-graphical=false

[Seat:*]
greeter-session=lightdm-gtk-greeter
user-session=xfce
EOF
rm -f -- /etc/lightdm/lightdm.conf.d/90-aura-autologin.conf

# O smoke e seu timer pertencem apenas à ISO live.
rm -f -- \
  /etc/systemd/system/aura-session-ready.service \
  /etc/systemd/system/aura-session-ready.timer \
  /etc/systemd/system/timers.target.wants/aura-session-ready.timer
rm -f -- \
  /usr/local/bin/aura-session-ready \
  /usr/local/bin/aura-first-boot \
  /usr/local/bin/aura-validate-xfce-preset \
  /usr/local/bin/aura-validate-calamares
rm -f -- \
  /etc/skel/.config/autostart/aura-first-boot.desktop \
  /home/*/.config/autostart/aura-first-boot.desktop

# O arquivo archiso quebraria a geração normal do initramfs do Arch.
rm -f -- /etc/mkinitcpio.conf.d/archiso.conf
rm -f -- /etc/archiso-release

# O módulo removeuser já elimina a conta live. Este passo remove somente um
# home residual e preserva uma conta nova que também se chame aura.
if ! id -u "${LIVE_USER}" >/dev/null 2>&1; then
  rm -rf -- "/home/${LIVE_USER}"
fi
if getent group autologin >/dev/null; then
  groupdel autologin
fi

systemctl daemon-reload >/dev/null 2>&1 || true
visudo -c >/dev/null
