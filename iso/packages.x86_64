bluez
bluez-utils
pipewire
pipewire-pulse
pipewire-alsa
wireplumber
zram-generator

# --- Gráfico (VMware e hardware comum) ---
xorg-server
xorg-xinit
mesa
xf86-input-vmmouse
open-vm-tools

# --- Desktop ---
# Componentes explícitos: a sessão e o preset não dependem da seleção
# automática do grupo xfce4 nem do conjunto xfce4-goodies.
xfce4-session
xfce4-panel
xfwm4
xfdesktop
xfce4-settings
xfce4-appfinder
xfce4-whiskermenu-plugin
xfce4-pulseaudio-plugin
xfce4-power-manager
xfce4-notifyd
xfconf
garcon
lightdm
lightdm-gtk-greeter
picom

# --- Tema e fontes ---
materia-gtk-theme
papirus-icon-theme
ttf-roboto
ttf-jetbrains-mono
noto-fonts
noto-fonts-emoji
adwaita-icon-theme

